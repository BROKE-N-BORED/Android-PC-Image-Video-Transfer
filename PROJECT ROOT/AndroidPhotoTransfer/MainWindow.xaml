<Window x:Class="AndroidPhotoTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AndroidPhotoTransfer.UI.ViewModels"
        xmlns:views="clr-namespace:AndroidPhotoTransfer.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Android Photo Transfer for Windows"
        Width="1220" Height="780" MinWidth="960" MinHeight="580"
        Background="White" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectedLibrary.SelectAllCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatePanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,14,0,10" />
        </Style>

        <Style x:Key="StatePanelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="18,9,18,6" Background="Transparent" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Margin="0,0,2,0">
                            <ContentPresenter x:Name="Header" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAEAEA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" Padding="14,7,14,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               Visibility="{Binding HasMultiplePhones, Converter={StaticResource InverseBoolToVis}}" />
                    <ComboBox ItemsSource="{Binding Phones}" DisplayMemberPath="Name" SelectedValuePath="DeviceId"
                              SelectedValue="{Binding SelectedPhoneId}" MinWidth="220" VerticalAlignment="Center"
                              IsEnabled="{Binding IsIdle}" ToolTip="Choose which phone to use"
                              Visibility="{Binding HasMultiplePhones, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="9" Height="9" Margin="14,1,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9E9E9E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Ready">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Locked">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                            ToolTip="Reconnect to the phone and rescan it — use this after taking new photos or if anything looks stuck (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Refresh / Rescan Phone" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenSettingsCommand}" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== Tabs ============================== -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Padding="0" Background="White">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1" Padding="8,0,0,0">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- The name matters: WPF exposes tab content to screen readers/UI Automation through it. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Style="{StaticResource TabHeader}" AutomationProperties.Name="Photos and Videos tab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Photos &amp; Videos" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MediaLibrary.ItemCount, StringFormat={}  {0:N0}}" Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:LibraryView x:Name="MediaView" DataContext="{Binding MediaLibrary}" />
            </TabItem>

            <TabItem Style="{StaticResource TabHeader}" AutomationProperties.Name="Files tab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Files" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilesLibrary.ItemCount, StringFormat={}  {0:N0}}" Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:LibraryView x:Name="FilesView" DataContext="{Binding FilesLibrary}" />
            </TabItem>
        </TabControl>

        <!-- ============================== Connection states (cover both tabs) ============================== -->
        <Border Grid.Row="1" Background="White" Visibility="{Binding ShowWaitingPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="#A9AEB5" HorizontalAlignment="Center" />
                <TextBlock Text="PHONE NOT CONNECTED" Style="{StaticResource StatePanelTitle}" />
                <TextBlock Text="Connect your Android phone to this PC with a USB cable." Style="{StaticResource StatePanelText}" />
                <TextBlock Text="Waiting for device…" Style="{StaticResource StatePanelText}" Margin="0,12,0,12" />
                <TextBlock Text="If prompted on your phone, choose &quot;File Transfer&quot; or &quot;MTP&quot;." Style="{StaticResource StatePanelText}" />
                <TextBlock Text="Plugged in but nothing happens? Some cables only charge — try a different (data) cable."
                           Style="{StaticResource StatePanelText}" FontSize="12" Margin="0,8,0,0" />
                <Button Content="Check Again" Command="{Binding CheckAgainCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="120" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Visibility="{Binding ShowConnectingPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DeviceName, StringFormat=Connecting to {0}…}" Style="{StaticResource StatePanelTitle}" />
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Visibility="{Binding ShowLockedPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="PHONE DETECTED" Style="{StaticResource StatePanelTitle}" />
                <TextBlock Text="Windows can see your phone, but its storage is unavailable." Style="{StaticResource StatePanelText}" Margin="0,0,0,12" />
                <TextBlock Text="1.  Unlock your phone." Style="{StaticResource StatePanelText}" />
                <TextBlock Text="2.  Select &quot;File Transfer&quot; if prompted (tap Allow if asked about access to phone data)." Style="{StaticResource StatePanelText}" />
                <TextBlock Text="(No prompt? Swipe down from the top of the phone's screen, tap the USB notification and choose File Transfer.)"
                           Style="{StaticResource StatePanelText}" FontSize="12" Margin="0,8,0,0" />
                <TextBlock Text="Waiting…" Style="{StaticResource StatePanelText}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Visibility="{Binding ShowErrorPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="COULDN'T CONNECT TO THE PHONE" Style="{StaticResource StatePanelTitle}" />
                <TextBlock Text="{Binding DeviceErrorMessage}" Style="{StaticResource StatePanelText}" />
                <TextBlock Text="Retrying automatically…" Style="{StaticResource StatePanelText}" Margin="0,10,0,0" />
                <Button Content="Try Again" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="120" />
            </StackPanel>
        </Border>

        <!-- ============================== Transfer bar (follows the selected tab) ============================== -->
        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="16,10,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" DataContext="{Binding SelectedLibrary}">
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="{Binding UntickTransferredText}" Command="{Binding UntickTransferredCommand}"
                            Style="{StaticResource ToolbarButton}" Foreground="{StaticResource AccentBrush}" Padding="8,1" MinHeight="22"
                            Margin="10,0,0,0" ToolTip="Deselect the ticked items that were already copied to this PC"
                            Visibility="{Binding SelectedTransferredCount, Converter={StaticResource PositiveToVis}}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Save To:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding DestinationFolder, Mode=OneWay}" IsReadOnly="True"
                             VerticalContentAlignment="Center" Padding="6,4" ToolTip="{Binding DestinationFolder}"
                             AutomationProperties.Name="Destination folder" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Browse..." Command="{Binding BrowseDestinationCommand}" IsEnabled="{Binding IsIdle}" />
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenDestinationCommand}" Margin="2,0,0,0"
                                ToolTip="Open the destination folder" AutomationProperties.Name="Open destination folder">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" DataContext="{Binding SelectedLibrary}">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanSelect}" Margin="0,0,8,0"
                                ToolTip="Tick everything in the current view (Ctrl+A)" />
                        <Button Content="Clear" Command="{Binding ClearSelectionCommand}" IsEnabled="{Binding CanSelect}" Margin="0,0,8,0" />
                        <Button Content="{Binding ImportNewText}" Command="{Binding ImportNewCommand}" IsEnabled="{Binding CanImportNew}" Margin="0,0,8,0"
                                ToolTip="Copy only what hasn't been transferred from this phone before" />
                        <Button Content="Transfer All" Command="{Binding TransferAllCommand}" IsEnabled="{Binding CanTransferAll}" Margin="0,0,8,0"
                                ToolTip="Copy everything in this tab (files already on this PC are skipped)" />
                        <Button Content="{Binding TransferButtonText}" Command="{Binding TransferSelectedCommand}" IsEnabled="{Binding CanTransferSelected}"
                                Style="{StaticResource PrimaryButton}" MinWidth="136" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================== Status bar ============================== -->
        <Border Grid.Row="3" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="110" Height="4" VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================== Transfer panel ============================== -->
        <Border Grid.RowSpan="4" Background="#7F000000" DataContext="{Binding Transfer}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <!-- Running -->
                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentFile}" Margin="0,16,0,8" TextTrimming="CharacterEllipsis" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Height="10" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Value="{Binding FilePercent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,52,0"
                                     Foreground="#7FA9D6" Background="Transparent" BorderThickness="0" ToolTip="Current file" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FilesText}" />
                                <TextBlock Text="{Binding BytesText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- Live counters -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#E6F4EA" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" ToolTip="Copied so far">
                                    <TextBlock Foreground="#1E7B34" FontWeight="SemiBold" Text="{Binding LiveCopied, StringFormat=Copied {0:N0}}" />
                                </Border>
                                <Border Background="#EEF0F3" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" ToolTip="Already on this PC, so not copied again">
                                    <TextBlock Foreground="#4A5058" FontWeight="SemiBold" Text="{Binding LiveSkipped, StringFormat=Skipped {0:N0}}" />
                                </Border>
                                <Border CornerRadius="10" Padding="10,3" ToolTip="Couldn't be copied — use Retry Failed at the end">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF0F3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveFailed}" Value="0">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding LiveFailed, StringFormat=Failed {0:N0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LiveFailed}" Value="0">
                                                        <Setter Property="Foreground" Value="#4A5058" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SpeedText, StringFormat=Current: {0}}" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ElapsedText, StringFormat=Elapsed: {0}}" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding RemainingText, StringFormat=Remaining: {0}}" Foreground="{StaticResource SubtleTextBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" MinWidth="96" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="96" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Complete -->
                    <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CompletionTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CompletionSummary}" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock Text="{Binding CompletionCounts}" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="{Binding CompletionDetail}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                        <ListBox ItemsSource="{Binding FailureDetails}" MaxHeight="160" Margin="0,12,0,0" FontSize="12"
                                 Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="View Details" Command="{Binding ToggleDetailsCommand}" Margin="4"
                                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Retry Failed" Command="{Binding RetryFailedCommand}" IsEnabled="{Binding ResumeAvailable}" Margin="4"
                                    Visibility="{Binding CanRetryFailed, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Resume" Command="{Binding ResumeCommand}" IsEnabled="{Binding ResumeAvailable}" Margin="4"
                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Margin="4" />
                            <Button Content="Done" Command="{Binding DoneCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="4" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ============================== Message panel ============================== -->
        <Border Grid.RowSpan="4" Background="#7F000000" Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding MessageTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MessageBody}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Choose Another Folder" Command="{Binding ChangeFolderFromMessageCommand}" Margin="0,0,8,0"
                                Visibility="{Binding MessageOffersFolderChange, Converter={StaticResource BoolToVis}}" />
                        <Button Content="OK" Command="{Binding DismissMessageCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================== First launch ============================== -->
        <Border Grid.RowSpan="4" Background="White" Visibility="{Binding ShowFirstRun, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="56" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Android Photo Transfer for Windows" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8" />
                <TextBlock Text="Copy photos, videos and files from your Android phone to this PC over a USB cable." FontSize="15"
                           Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="Nothing needs to be installed on your phone." FontSize="15"
                           Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                <StackPanel Margin="40,28,40,0">
                    <TextBlock Text="1.  Connect your phone with a USB cable." FontSize="15" Margin="0,4" />
                    <TextBlock Text="2.  Unlock the phone." FontSize="15" Margin="0,4" />
                    <TextBlock Text="3.  Choose &quot;File Transfer&quot; if Android asks." FontSize="15" Margin="0,4" />
                </StackPanel>
                <Button Content="Get Started" Command="{Binding GetStartedCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Margin="0,32,0,0" MinWidth="160" Padding="20,9" FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
